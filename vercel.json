{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "app/ui/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(app.js|style.css|favicon.ico|favicon.svg|apple-touch-icon.png|favicon-96x96.png|site.webmanifest)",
      "dest": "app/ui/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/ui/index.html"
    }
  ]
}