# ============================================================
# UniSched ERP — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=production
PORT=8000
LOCAL_MODE=false

# ── Security ─────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Supabase (Production) ────────────────────────────────────
SUPABASE_URL=
# Publishable/anon key — safe to use client-side if RLS is correctly configured
SUPABASE_KEY=
# Service-role key — NEVER expose to frontend or browser
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection URL (used by backend only)
DATABASE_URL=
DATABASE_SCHEMA=public

# ── Local SQLite (Development only) ─────────────────────────
# DATABASE_PATH=database/timetable.db

# ── AI Providers ─────────────────────────────────────────────
# Primary provider: openrouter | groq | cerebras | gemini
AI_PROVIDER=gemini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free

GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO